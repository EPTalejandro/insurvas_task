# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173

# YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY=

# Instagram Graph API / Business Discovery (Meta app + YOUR professional account)
META_GRAPH_VERSION=
IG_USER_ID=
IG_ACCESS_TOKEN=

# Gemini API (free tier). Empty key = rules labeler only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_RPM=10
LABELER=auto

# Pipeline limits
YOUTUBE_DISCOVERY_QUOTA=3000
MAX_COMPETITORS=100
LOOKBACK_DAYS=90
MAX_POSTS_PER_ACCOUNT=50
